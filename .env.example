# MongoDB Atlas or a local replica set is required for atomic coin awards.
MONGODB_URI=mongodb://localhost:27017/habithero?replicaSet=rs0
# Generate a private value with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PORT=3000
# Set only to the exact number of trusted reverse proxies in front of the server.
TRUST_PROXY_HOPS=0
# Optional. Without a key, AI missions safely enter the parent review inbox.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
# Use mongodb on Render's free service so private photos survive restarts without a disk.
EVIDENCE_STORAGE=filesystem
# With filesystem storage only: private persistent volume outside public/ and dist/.
EVIDENCE_DIR=./private-evidence
